@model IEnumerable<Reading>
@{
    ViewData["Title"] = "All Readings";
}

<div class="page-header">
    <h1>All Readings</h1>
    <a asp-action="Create" class="btn btn-primary">+ New Reading</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📊</div>
        <p>No readings yet. Add your first reading to get started.</p>
        <a asp-action="Create" class="btn btn-primary">Add First Reading</a>
    </div>
}
else
{
    <div class="notice notice-info">
        <strong>Tip:</strong> At least two readings are required before a usage report can be calculated.
        All water values are in <strong>Litres (L)</strong>.
    </div>

    <div class="table-wrapper">
        <table class="readings-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Main Water (L)</th>
                    <th>P1 Up (L)</th>
                    <th>P1 Down (L)</th>
                    <th>P1 Top-up (L)</th>
                    <th>P2 Up (L)</th>
                    <th>P2 Down (L)</th>
                    <th>P2 Top-up (L)</th>
                    <th>Electricity (kWh)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="date-cell">@r.ReadingDate.ToString("dd MMM yyyy")</td>
                        <td>@r.MainWaterUp.ToString("N3")</td>
                        <td>@r.Prepaid1Up.ToString("N3")</td>
                        <td>@r.Prepaid1Down.ToString("N3")</td>
                        <td class="topup-cell">@r.Prepaid1TopUp.ToString("N3")</td>
                        <td>@r.Prepaid2Up.ToString("N3")</td>
                        <td>@r.Prepaid2Down.ToString("N3")</td>
                        <td class="topup-cell">@r.Prepaid2TopUp.ToString("N3")</td>
                        <td>@r.ElectricityUp.ToString("N3")</td>
                        <td class="actions-cell">
                            <a asp-action="Report" asp-route-id="@r.Id" class="btn btn-sm btn-secondary">Report</a>
                            <a asp-controller="Pdf" asp-action="Report" asp-route-id="@r.Id" class="btn btn-sm btn-pdf" target="_blank">PDF</a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
