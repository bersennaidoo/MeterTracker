@model Reading
@{
    ViewData["Title"] = "New Reading";
}

<div class="page-header">
    <h1>New Reading</h1>
</div>

<div class="notice notice-warning">
    ⚠️ <strong>All fields are mandatory (BR7).</strong>
    Enter <strong>0</strong> for Top-up Amount if no voucher was loaded since the last reading.
    All water values are in <strong>Litres (L)</strong>.
</div>

<form asp-action="Create" method="post" class="reading-form" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            <strong>Please fix the following errors:</strong>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- Reading Date -->
    <div class="form-section">
        <h2 class="section-title">📅 Reading Date</h2>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="ReadingDate"></label>
                <input asp-for="ReadingDate" type="date" class="form-control" />
                <span asp-validation-for="ReadingDate" class="field-error"></span>
            </div>
        </div>
    </div>

    <!-- Main Water -->
    <div class="form-section">
        <h2 class="section-title">💧 Main Water</h2>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="MainWaterUp"></label>
                <input asp-for="MainWaterUp" type="number" step="0.001" min="0" class="form-control"
                       placeholder="e.g. 1234567.000" />
                <span asp-validation-for="MainWaterUp" class="field-error"></span>
                <small class="field-hint">Up counter — increases over time. Value in Litres (L).</small>
            </div>
        </div>
    </div>

    <!-- Prepaid Meter 1 -->
    <div class="form-section">
        <h2 class="section-title">🔵 Prepaid Meter 1</h2>
        <div class="form-row form-row-3">
            <div class="form-group">
                <label asp-for="Prepaid1Up"></label>
                <input asp-for="Prepaid1Up" type="number" step="0.001" min="0" class="form-control"
                       placeholder="e.g. 987654.000" />
                <span asp-validation-for="Prepaid1Up" class="field-error"></span>
                <small class="field-hint">Up counter (L)</small>
            </div>
            <div class="form-group">
                <label asp-for="Prepaid1Down"></label>
                <input asp-for="Prepaid1Down" type="number" step="0.001" min="0" class="form-control"
                       placeholder="e.g. 45200.000" />
                <span asp-validation-for="Prepaid1Down" class="field-error"></span>
                <small class="field-hint">Down counter — decreases as tenant uses water (L)</small>
            </div>
            <div class="form-group">
                <label asp-for="Prepaid1TopUp"></label>
                <input asp-for="Prepaid1TopUp" type="number" step="0.001" min="0" class="form-control"
                       placeholder="0.000" value="0" />
                <span asp-validation-for="Prepaid1TopUp" class="field-error"></span>
                <small class="field-hint mandatory-hint">Mandatory — enter 0 if no top-up occurred (L)</small>
            </div>
        </div>
    </div>

    <!-- Prepaid Meter 2 -->
    <div class="form-section">
        <h2 class="section-title">🟢 Prepaid Meter 2</h2>
        <div class="form-row form-row-3">
            <div class="form-group">
                <label asp-for="Prepaid2Up"></label>
                <input asp-for="Prepaid2Up" type="number" step="0.001" min="0" class="form-control"
                       placeholder="e.g. 876543.000" />
                <span asp-validation-for="Prepaid2Up" class="field-error"></span>
                <small class="field-hint">Up counter (L)</small>
            </div>
            <div class="form-group">
                <label asp-for="Prepaid2Down"></label>
                <input asp-for="Prepaid2Down" type="number" step="0.001" min="0" class="form-control"
                       placeholder="e.g. 30100.000" />
                <span asp-validation-for="Prepaid2Down" class="field-error"></span>
                <small class="field-hint">Down counter — decreases as tenant uses water (L)</small>
            </div>
            <div class="form-group">
                <label asp-for="Prepaid2TopUp"></label>
                <input asp-for="Prepaid2TopUp" type="number" step="0.001" min="0" class="form-control"
                       placeholder="0.000" value="0" />
                <span asp-validation-for="Prepaid2TopUp" class="field-error"></span>
                <small class="field-hint mandatory-hint">Mandatory — enter 0 if no top-up occurred (L)</small>
            </div>
        </div>
    </div>

    <!-- Electricity -->
    <div class="form-section">
        <h2 class="section-title">⚡ Electricity</h2>
        <div class="form-row">
            <div class="form-group">
                <label asp-for="ElectricityUp"></label>
                <input asp-for="ElectricityUp" type="number" step="0.001" min="0" class="form-control"
                       placeholder="e.g. 5678.900" />
                <span asp-validation-for="ElectricityUp" class="field-error"></span>
                <small class="field-hint">Up counter — increases over time (kWh)</small>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-large">Save Reading &amp; View Report</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
</form>
